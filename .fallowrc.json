{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/data/client-env.ts",
    "src/features/blog/actions/translate-post-action.ts",
    "src/lib/analytics/server.ts"
  ],
  "ignoreFindings": ["src/components/ui/**"],
  "health": {
    "ignore": ["**/*.test.ts", "**/*.test.tsx", "src/db/test-db.ts", "src/db/seed.ts"]
  },
  "rules": {
    "circular-dependencies": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-files": "error"
  }
}
